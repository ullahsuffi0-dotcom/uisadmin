{
  "rules": {
    ".read": false,
    ".write": false,

    "platform": {
      "schools": {
        ".read": true,
        ".write": "auth != null"
      },
      "admins": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },

    "schools": {
      "$schoolId": {
        ".read": true,
        ".write": true,

        "accounts": {
          ".read": true,
          ".write": true,
          "$accountIndex": {
            ".validate": "newData.hasChildren(['id', 'username', 'role', 'firstName'])"
          }
        },

        "settings": {
          ".read": true,
          ".write": true,
          ".validate": "newData.hasChildren(['schoolName'])"
        },

